{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../assets/Scripts/Core/*"]
    }
  },
  "include": ["**/*.ts", "../assets/Scripts/Core/**/*.ts"]
}
